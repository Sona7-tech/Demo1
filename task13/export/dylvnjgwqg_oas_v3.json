      "SignupRequest": {
        "title": "Signup request",
        "type": "object",
        "required": ["firstName", "lastName", "email", "password"],
        "properties": {
          "firstName": {
            "type": "string",
            "example": "John"
          },
          "lastName": {
            "type": "string",
            "example": "Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john.doe@example.com"
          },
          "password": {
            "type": "string",
            "description": "At least 12 characters; must contain upper case, lower case, digit and one of $%^*-_ characters.",
            "example": "Passw0rd$abc"
          }
        }
      },
      "SigninRequest": {
        "title": "Signin request",
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "john.doe@example.com"
