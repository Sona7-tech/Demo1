{
  "AppSyncDynamoDBPolicy": {
    "resource_type": "iam_policy",
    "policy_content": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": [
            "dynamodb:PutItem",
            "dynamodb:GetItem"
          ],
          "Resource": "arn:aws:dynamodb:${region}:${account_id}:table/Events"
        }
      ]
    },
    "tags": {}
  },

  "Events": {
    "resource_type": "dynamodb_table",
    "hash_key_name": "id",
    "hash_key_type": "S",
    "billing_mode": "PAY_PER_REQUEST",
    "read_capacity": 1,
    "write_capacity": 1,
    "global_indexes": [],
    "autoscaling": [],
    "tags": {}
  },

  "AppSyncDynamoDBRole": {
    "resource_type": "iam_role",
    "principal_service": "appsync",
    "custom_policies": [
      "AppSyncDynamoDBPolicy"
    ],
    "predefined_policies": [],
    "allowed_accounts": [],
    "instance_profile": false,
    "permissions_boundary": "",
    "tags": {}
  }
}